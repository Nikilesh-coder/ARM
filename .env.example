# ==============================================================================
# REPORTFORGE AI - Environment Configuration Template
# ==============================================================================

# Core System
PROJECT_NAME="ReportForge AI"
ENVIRONMENT="development"              # development | staging | production
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="development_secret_key_change_in_production"
LOG_LEVEL="INFO"                       # DEBUG | INFO | WARNING | ERROR

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database & Supabase (PostgreSQL)
# Use a local Postgres instance or connect directly to Supabase
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reportforge"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Storage Service Configuration
STORAGE_PROVIDER="local"               # 'local' (local disk storage) or 'supabase'
STORAGE_BUCKET_TEMPLATES="templates"
STORAGE_BUCKET_EVIDENCE="evidence"
STORAGE_BUCKET_REPORTS="reports"
DOCX_MAX_FILE_SIZE_MB=25
EVIDENCE_MAX_FILE_SIZE_MB=50

# AI Provider Credentials (Server-side only; never exposed to frontend)
DEFAULT_AI_PROVIDER="gemini"           # 'gemini' | 'mock'
DEFAULT_AI_MODEL="gemini-2.5-flash"
AI_TIMEOUT_SECONDS=60
GEMINI_API_KEY=""                      # Insert Google AI Studio API key here
OPENAI_API_KEY=""                      # Optional: OpenAI API key
ANTHROPIC_API_KEY=""                   # Optional: Anthropic API key
HF_TOKEN=""                            # Hugging Face User Access Token (Free monthly serverless inference)
HF_IMAGE_MODEL="black-forest-labs/FLUX.1-schnell"

# Research & Citations Provider (Pluggable academic verification)
RESEARCH_PROVIDER="tavily"
TAVILY_API_KEY=""

# Background Worker & Cache (Redis)
REDIS_URL="redis://localhost:6379/0"

# Visual Engine & Cloudflare Worker Image Generation Configuration
CLOUDFLARE_WORKER_URL="https://image-api.2024csm-r260.workers.dev/"
CLOUDFLARE_WORKER_API_KEY=""

CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""


TOGETHER_API_KEY=""

ARM_IMAGE_PROVIDER_COOLDOWN_SECONDS=300

# xKiro Image Generation (Primary Provider)
DEFAULT_IMAGE_PROVIDER="xkiro"
XKIRO_API_KEY=""
XKIRO_MODEL="sensenova/sensenova-u1.5-lite"
XKIRO_FREE_ONLY=true

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000"

