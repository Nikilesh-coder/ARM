# ==============================================================================
# ARM (REPORTFORGE AI) - Production & Development Environment Configuration
# ==============================================================================

# Core System
PROJECT_NAME="ReportForge AI"
ENVIRONMENT="development"              # development | staging | production
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="development_secret_key_change_in_production"
LOG_LEVEL="INFO"                       # DEBUG | INFO | WARNING | ERROR
PORT=8000                              # Automatically injected by Render as $PORT

# CORS Configuration (Render Backend)
FRONTEND_URL="https://your-arm-frontend.vercel.app"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database & Supabase (PostgreSQL)
# Server-side only; service role key must NEVER be exposed to frontend
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reportforge"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Storage Service Configuration
STORAGE_PROVIDER="supabase"            # 'supabase' (production) or 'local' (development)
STORAGE_BUCKET_TEMPLATES="templates"
STORAGE_BUCKET_EVIDENCE="evidence"
STORAGE_BUCKET_REPORTS="reports"
DOCX_MAX_FILE_SIZE_MB=25
EVIDENCE_MAX_FILE_SIZE_MB=50

# AI Provider Credentials (Server-side only; never exposed to frontend)
DEFAULT_AI_PROVIDER="gemini"           # 'gemini' | 'mock'
DEFAULT_AI_MODEL="gemini-2.5-flash"
AI_TIMEOUT_SECONDS=60
GEMINI_API_KEY=""                      # Google AI Studio API key
OPENAI_API_KEY=""                      # Optional
ANTHROPIC_API_KEY=""                   # Optional

# Image Generation Providers (Hierarchy: Cache -> Supernova/xKiro -> Cloudflare -> Local RTX -> HF -> Together)
DEFAULT_IMAGE_PROVIDER="xkiro"
XKIRO_API_KEY=""
XKIRO_MODEL="sensenova/sensenova-u1.5-lite"
XKIRO_FREE_ONLY=true

CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_IMAGE_MODEL="@cf/black-forest-labs/flux-1-schnell"

HF_TOKEN=""                            # Hugging Face User Access Token
HF_IMAGE_MODEL="black-forest-labs/FLUX.1-schnell"

TOGETHER_API_KEY=""
ARM_IMAGE_PROVIDER_COOLDOWN_SECONDS=300

# Document & Template Synthesis
DOCUMENT_PROVIDER="internal"
DOCUMENT_FALLBACK_TO_INTERNAL=true

# Frontend Configuration (Used by Next.js on Vercel)
NEXT_PUBLIC_API_URL="https://your-arm-backend.onrender.com"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
